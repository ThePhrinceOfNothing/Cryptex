{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Cryptex",
  "version": "1.2.1",
  "identifier": "com.cryptex.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Cryptex",
        "width": 1100,
        "height": 700,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENCOTBGQTkxREQxNjU5REIKUldUYldSYmRrZnFReTN2aDZqeERHbWltdlZTdkRmYXdVeEFVT2hLWEtTdlF2b1UrMHljZU5GSjEK",
      "endpoints": [
        "https://github.com/ThePhrinceOfNothing/Cryptex/releases/latest/download/latest.json"
      ]
    }
  }
}





